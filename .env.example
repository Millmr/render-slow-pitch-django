# Only needed when running Django outside Docker (docker-compose.yml sets
# these itself). Copy to .env; real environment variables win.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use SQLite. To use the compose Postgres from your Mac:
# DATABASE_URL=postgres://slowpitch:slowpitch@localhost:5432/slowpitch
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
